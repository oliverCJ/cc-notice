{
  "name": "cc-notice",
  "productName": "CC Notice",
  "version": "1.1.1",
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "tsc && vite build",
    "build:relay": "cargo build --manifest-path src-tauri/Cargo.toml --bin cc-notice-relay",
    "build:relay:release": "cargo build --manifest-path src-tauri/Cargo.toml --bin cc-notice-relay --release",
    "build:relay:asset": "npm run build:relay:release && node scripts/sync-relay-asset.mjs",
    "package:mac:x64": "node scripts/package-macos.mjs x64",
    "package:mac:arm64": "node scripts/package-macos.mjs arm64",
    "package:mac:universal": "node scripts/package-macos.mjs universal",
    "package:mac:all": "node scripts/package-macos.mjs all",
    "package:win": "npm run build:relay:asset && npx tauri build --bundles nsis",
    "build:app": "npm run build:relay:asset && npm run build",
    "test": "vitest run",
    "tauri": "node scripts/tauri-dev.mjs"
  },
  "dependencies": {
    "@lottiefiles/dotlottie-react": "^0.19.12",
    "@radix-ui/react-alert-dialog": "^1.1.16",
    "@radix-ui/react-checkbox": "^1.3.4",
    "@radix-ui/react-dialog": "^1.1.16",
    "@radix-ui/react-dropdown-menu": "^2.1.17",
    "@radix-ui/react-label": "^2.1.9",
    "@radix-ui/react-radio-group": "^1.4.0",
    "@radix-ui/react-scroll-area": "^1.2.11",
    "@radix-ui/react-select": "^2.3.0",
    "@radix-ui/react-separator": "^1.1.9",
    "@radix-ui/react-slot": "^1.2.5",
    "@radix-ui/react-switch": "^1.3.0",
    "@radix-ui/react-tabs": "^1.1.14",
    "@radix-ui/react-toast": "^1.2.16",
    "@tauri-apps/api": "^2.0.0",
    "@tauri-apps/plugin-dialog": "^2.0.0",
    "class-variance-authority": "^0.7.1",
    "clsx": "^2.1.1",
    "lucide-react": "^0.468.0",
    "react": "^18.3.1",
    "react-diff-viewer-continued": "^4.2.2",
    "react-dom": "^18.3.1",
    "recharts": "^3.8.1",
    "tailwind-merge": "^3.6.0"
  },
  "devDependencies": {
    "@tauri-apps/cli": "^2.0.0",
    "@testing-library/jest-dom": "^6.6.3",
    "@testing-library/react": "^16.1.0",
    "@types/node": "^25.9.3",
    "@types/react": "^18.3.12",
    "@types/react-dom": "^18.3.1",
    "@vitejs/plugin-react": "^4.3.3",
    "autoprefixer": "^10.5.0",
    "jsdom": "^25.0.1",
    "postcss": "^8.5.15",
    "tailwindcss": "^3.4.19",
    "typescript": "^5.6.3",
    "vite": "^5.4.11",
    "vitest": "^2.1.5"
  }
}
